{
  "name": "@bhagyeshhjain/json-schema-form-builder",
  "version": "1.0.0",
  "type": "module",
  "description": "A premium, schema-driven visual form building system for React. Drag & drop form designer with JSON Schema, Zod, and React component code generation.",
  "author": "bhagyeshhjain",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/bhagyeshhjain/json-schema-form-builder.git"
  },
  "homepage": "https://github.com/bhagyeshhjain/json-schema-form-builder",
  "bugs": {
    "url": "https://github.com/bhagyeshhjain/json-schema-form-builder/issues"
  },
  "keywords": [
    "react",
    "form-builder",
    "json-schema",
    "zod",
    "drag-and-drop",
    "visual-editor",
    "form-generator",
    "react-component",
    "schema-form",
    "typescript"
  ],
  "main": "dist/json-schema-form-builder.umd.cjs",
  "module": "dist/json-schema-form-builder.es.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/json-schema-form-builder.es.js",
      "require": "./dist/json-schema-form-builder.umd.cjs",
      "types": "./dist/index.d.ts"
    },
    "./styles": "./dist/style.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:lib": "vite build --mode lib",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "immer": "^11.1.8",
    "lucide-react": "^1.14.0",
    "nanoid": "^5.1.11",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "vite-plugin-dts": "^4.5.4"
  }
}
